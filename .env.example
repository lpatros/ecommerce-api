# Spring Boot Application Configuration
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Hibernate
SHOW_SQL=true

# Profile
SPRING_PROFILES_ACTIVE=mock

# JWT Configuration
JWT_SECRET=secret-jwt-key-ecommerce-api-security-0123456789abcdef
JWT_EXPIRATION=2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Docker Compose Configuration
POSTGRES_DB=ecommerce
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432
TZ=America/Sao_Paulo

# TEST
JWT_SECRET_TEST=test-secret-key-ecommerce-api-security-0123456789abcdef
JWT_EXPIRATION_TEST=2